# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api
#
# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# -----------------------------------------------------------------------------
# AI Configuration (server-side only)
# -----------------------------------------------------------------------------
# Ka-Lakbay's AI provider is not decided yet. These variables select and
# configure it, so no feature code changes when a vendor is chosen.
#
# SECURITY: none of these may use a NEXT_PUBLIC_ prefix. Next.js inlines
# NEXT_PUBLIC_* into the browser bundle, so a prefixed secret would be public.
# All AI access goes through lib/ai, which imports "server-only" and will fail
# to build if a client component reaches for it.
#
# Only one provider is implemented: mock. It is deterministic, needs no
# credentials, and returns labelled placeholder text — it is not a real model.

# Provider to use. Implemented: mock
AI_PROVIDER=mock

# Default model. Leave blank to use the selected provider's own default.
# When a real provider is chosen, its model ids go here.
AI_MODEL=

# Metadata-only development logging (provider, model, duration, outcome).
# Never logs prompts or responses. On by default in development, off in
# production. Set to 0 to silence it locally.
AI_DEBUG=1

# -----------------------------------------------------------------------------
# Future provider credentials
# -----------------------------------------------------------------------------
# Added when a provider is implemented, never before. Kept server-side and
# unprefixed. lib/ai/config.ts asserts the selected provider's key is present,
# so a missing value fails with a clear configuration error instead of a
# confusing request failure.
#
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
