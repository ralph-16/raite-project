# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api-keys
#
# Use the new-format keys: sb_publishable_... (public, was "anon") and
# sb_secret_... (server-only, was "service_role"). Legacy anon/service_role
# keys still work during the migration window but are deprecated.
#
# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local
#
# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# -----------------------------------------------------------------------------
# AI Configuration (server-side only)
# -----------------------------------------------------------------------------
# Ka-Lakbay's AI provider is not decided yet. These variables select and
# configure it, so no feature code changes when a vendor is chosen.
#
# SECURITY: none of these may use a NEXT_PUBLIC_ prefix. Next.js inlines
# NEXT_PUBLIC_* into the browser bundle, so a prefixed secret would be public.
# All AI access goes through lib/ai, which imports "server-only" and will fail
# to build if a client component reaches for it.
#
# Two providers are implemented: mock (deterministic, no credentials,
# labelled placeholder text — not a real model) and gemini (real model,
# needs GEMINI_API_KEY below).

# Provider to use. Implemented: mock, gemini
AI_PROVIDER=mock

# Default model. Leave blank to use the selected provider's own default
# (mock-echo-v1 for mock, gemini-3.8-flash for gemini).
AI_MODEL=

# Fallback models, tried once each after the primary's retries are exhausted.
# Comma-separated, e.g. "gemini-3.8-flash,gemini-3.6-flash". Leave blank for none.
AI_MODEL_FALLBACKS=

# Metadata-only development logging (provider, model, duration, outcome).
# Never logs prompts or responses. On by default in development, off in
# production. Set to 0 to silence it locally.
AI_DEBUG=1

# -----------------------------------------------------------------------------
# Provider credentials
# -----------------------------------------------------------------------------
# Set the key for the provider selected above. Kept server-side and
# unprefixed. lib/ai/config.ts asserts the selected provider's key is present,
# so a missing value fails with a clear configuration error instead of a
# confusing request failure.
#
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Optional: service role key (server-side only)
# -----------------------------------------------------------------------------
# Enables the writes the database reserves for the server: profiles.ai_context
# and profiles.onboarding_completed (both rejected for authenticated users by
# a guard trigger). Without it the app reports aiContextPersisted: false and
# records onboarding completion per device instead of in the database.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Demo mode
# -----------------------------------------------------------------------------
# true  → the UI runs on static JSON in /data + localStorage (lib/mock/*).
#         No calls to Supabase and no calls to any /api AI route.
# false → the current real behaviour (Supabase auth, AI routes) is unchanged.
NEXT_PUBLIC_MOCK_MODE=true
